# Reference for the values the container reads. `./setup.sh docker` writes a real .env for
# you, with defaults detected from the machine, so copy this only if you would rather
# configure it by hand:
#
#   cp .env.example .env

# The address you will type in the browser. It goes into the certificate's subjectAltName
# and into CSRF_TRUSTED_ORIGINS, so it has to match exactly. Use the server's LAN address,
# or localhost when running on your own machine.
#
# Reaching the app on any other address than this one will fail CSRF checks on POST.
FILMCASE_HOST=localhost
FILMCASE_HTTPS_PORT=8443

# Which machine the camera is plugged into.
#
#   browser  the camera is attached to whichever machine you browse from, and your
#            browser talks to it over WebUSB. This is the default: a container on a NAS or
#            any host you do not sit in front of cannot reach a camera plugged in elsewhere,
#            so this is the mode that works out of the box for a Docker install.
#   server   the camera is attached to the machine running Filmcase, and the container
#            talks to it over USB. Use this only when you have passed the device into the
#            container.
#
# Browser mode needs a secure context, so reach the app over HTTPS or on localhost, and
# use a Chromium browser: Firefox and Safari have no WebUSB. Check yours at
# /camera/diagnostics/.
CAMERA_TRANSPORT=browser

# Ownership for the mounted directories and the app process. These should be the user that
# owns your photo directories: run `id <your-user>` on the host to find them.
PUID=1000
PGID=1000

# Web concurrency is workers times threads. Threads are the cheaper of the two, since each
# worker is a whole Python process while threads share one, and the workload is dominated by
# waiting on the database and the filesystem.
FILMCASE_WEB_WORKERS=2
FILMCASE_WEB_THREADS=4

# How many photos are processed at once. This is Celery's --concurrency, the pool inside a
# single worker, not a number of workers. Each process loads Django and Pillow, so on a
# small server keep it near the core count rather than above it.
FILMCASE_WORKER_CONCURRENCY=4

# Images per dispatch message. Each batch is expanded into one task per image by the worker
# that receives it, so this controls how quickly a large sync starts rather than how many
# workers it can keep busy.
SYNC_IMAGE_BATCH_SIZE=100

# Django signing key. Generate one with:
#
#   openssl rand -base64 48
FILMCASE_SECRET_KEY=change-me

# PostgreSQL password. Only reachable from inside the compose network. Changing it after
# the first start locks the app out of the existing database volume.
FILMCASE_DB_PASSWORD=change-me
